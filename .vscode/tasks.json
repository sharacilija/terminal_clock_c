{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build current C file",
            "type": "process",
            "command": "C:/msys64/mingw64/bin/gcc.exe",
            "args": [
                "-std=c17",
                "-Wall",
                "-Wextra",
                "-g",
                "main.c",
                "-o",
                "main.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compile the currently open C file with MSYS2 MinGW64 GCC"
        }
    ]
}